{% extends 'base.html.twig' %}

{% block title %}Connexion - PKMNSheet{% endblock %}

{% block body %}
    <main>
        <h1>Connexion</h1>

        {% for message in app.flashes('success') %}
            <p role="status">{{ message }}</p>
        {% endfor %}

        {% if error %}
            <p role="alert">Adresse e-mail ou mot de passe incorrect.</p>
        {% endif %}

        <form method="post">
            <label for="username">Adresse e-mail</label>
            <input id="username" type="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>

            <label for="password">Mot de passe</label>
            <input id="password" type="password" name="_password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit">Se connecter</button>
        </form>

        <p>Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
        <p><a href="{{ path('app_home') }}">Retour à l’accueil</a></p>
    </main>
{% endblock %}
